#!/usr/bin/make -f

export LC_ALL = C
export TZ = UTC
export SOURCE_DATE_EPOCH := $(shell dpkg-parsechangelog -STimestamp)

DEB_CFLAGS = -O2 -fno-strength-reduce -Wall -Wno-deprecated-declarations \
	-D_REENTRANT -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=1

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure --sourcedirectory=src -- \
		--prefix=/usr \
		--with-features=huge \
		--enable-copilot \
		--with-vim-name=vim-copilot \
		--with-ex-name=ex-copilot \
		--with-view-name=view-copilot \
		--with-modified-by=vim-copilot \
		CFLAGS="$(DEB_CFLAGS) $(CFLAGS)"

override_dh_auto_build:
	$(MAKE) -C src

override_dh_auto_test:
	$(MAKE) -C src/testdir test_copilot.res VIMPROG=../vim-copilot

override_dh_auto_install:
	$(MAKE) -C src installvim DESTDIR=$(CURDIR)/debian/vim-copilot

override_dh_auto_clean:
	if test -f src/auto/config.mk; then $(MAKE) -C src clean; fi
	rm -f src/auto/config.cache src/auto/config.h src/auto/config.mk \
		src/auto/pathdef.c